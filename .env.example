# Microsoft Entra ID app registration values.
MS_TENANT_ID=your-tenant-id
MS_CLIENT_ID=your-client-id
MS_CLIENT_SECRET=your-client-secret

# The mailbox that has permission to send through Microsoft Graph.
OUTLOOK_SENDER=admin@araspl.com

# Recipient and message settings.
EMAIL_TO=admin@araspl.com
EMAIL_TEMPLATE=reminder
EMAIL_SUBJECT=Scheduled reminder
EMAIL_NAME=Admin

# The scheduler interval is intentionally 30 seconds by default.
INTERVAL_SECONDS=30